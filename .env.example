# Copy this file to .env (same folder as docker-compose.yml) and set your
# own value. .env is gitignored — your real password never gets committed
# or pushed to GitHub.
#
# Same pattern as the Hunger Hive app: a single password, no username.
# Leave this unset/blank to run the app with no login at all (handy for
# local testing).
APP_PASSWORD=changeme
